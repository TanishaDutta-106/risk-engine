# ─────────────────────────────────────────────
# Real-Time Risk Engine — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=riskengine
POSTGRES_USER=riskuser
POSTGRES_PASSWORD=riskpassword
DATABASE_URL=postgresql+asyncpg://riskuser:riskpassword@localhost:5432/riskengine

# ── Redis ─────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_STREAM_KEY=trade_events        # Stream key for incoming trade events
REDIS_CONSUMER_GROUP=risk_engine     # Consumer group name
REDIS_CONSUMER_NAME=worker_1         # This worker's consumer name

# ── Risk Thresholds ───────────────────────────
VAR_CONFIDENCE_LEVEL=0.95            # 95th percentile VaR
VAR_LOOKBACK_DAYS=252                # 1 year of historical returns
VAR_ALERT_THRESHOLD=0.05             # Fire alert if VaR > 5% of portfolio value

CONCENTRATION_LIMIT=0.20             # Max 20% of portfolio in any single asset
MARGIN_UTILIZATION_LIMIT=0.80        # Alert if margin used > 80%

# ── API ───────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── Simulator ─────────────────────────────────
SIMULATOR_EVENTS_PER_SECOND=5        # Trade event generation rate
SIMULATOR_NUM_ASSETS=10              # Number of simulated assets
SIMULATOR_NUM_PORTFOLIOS=3           # Number of simulated portfolios
